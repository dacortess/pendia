# Copiar a backend/.env — NUNCA commitear el .env real

DATABASE_URL=postgresql+psycopg://app:app_dev_only@localhost:5432/gestor_pagos

JWT_SECRET=change-me-to-a-random-256-bit-value
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Dominio exacto del frontend desplegado, para CORS (ADR-001/ADR-008)
FRONTEND_ORIGIN=https://gestor-pagos.pages.dev

# Argon2id (valores default razonables; ajustar según recursos del host)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KB=65536
ARGON2_PARALLELISM=2

ENVIRONMENT=development
